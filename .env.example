# Copy to .env.local and fill in. Never commit real values.
# Separate values are used for development, preview and production (set in Vercel).

# Public URL of the site, used for metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). The anon key is safe in the browser;
# access is controlled by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS: use solely in server code after an explicit
# authorization check. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Database tests (npm run test:db). Any PostgreSQL 15+ you can create databases on;
# the default matches the database started by `supabase start`.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Direct Data API security tests (npm run test:api) against a local stack with
# dev users (scripts/seed-dev-users.mjs). Leave unset to skip them.
SUPABASE_API_TEST_URL=
SUPABASE_API_TEST_ANON_KEY=

# WhatsApp absence alerts (server only; see docs/whatsapp-templates.md).
# off = nothing sent (default), test = only WHATSAPP_TEST_RECIPIENTS, live = all consenting guardians.
WHATSAPP_MODE=off
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=absence_alert
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEST_RECIPIENTS=
# Secret Vercel Cron sends to /api/cron/notifications.
CRON_SECRET=
